# Copy to backend/.env (never commit .env)

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_long_random_secret
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7

# CORS — comma-separated origins (Vercel + local)
CLIENT_URL=http://localhost:3030
CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030,https://your-app.vercel.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10

# File uploads (bytes)
MAX_FILE_SIZE=5242880

# Fixer online presence (heartbeat + stale timeout ms)
PRESENCE_TTL_MS=90000
PRESENCE_JANITOR_MS=60000

# SMS / OTP — required for real handset delivery in production
# Set SMS_TEST_MODE=false on Render when using a real provider
SMS_TEST_MODE=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_FLOW_ID=
MSG91_SENDER_ID=FIXGHAR
# Twilio (alternative to MSG91)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# OTP rate limit (requests per 15 min per IP)
OTP_RATE_LIMIT_MAX=5

# Production: require database
# DB_FAIL_FAST=true
